DATABASE_URL="postgresql://yardsale:yardsale@localhost:5433/yardsale"
# Generate with `npm run admin:password`. Next.js interpolates $VAR syntax in
# env files, so escape every "$" in the hash as "\$" or it will be corrupted.
ADMIN_PASSWORD_HASH=""
SESSION_SECRET=""
UPLOAD_DIR="./.uploads"

# Optional. Enables photo clustering and Hebrew copy on the bulk import screen.
# Without it the import screen falls back to grouping by capture time.
ANTHROPIC_API_KEY=""
