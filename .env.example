DATABASE_URL="postgresql://yardsale:yardsale@localhost:5433/yardsale"
# Generate with `npm run admin:password`. Next.js interpolates $VAR syntax in
# env files, so escape every "$" in the hash as "\$" or it will be corrupted.
ADMIN_PASSWORD_HASH=""
SESSION_SECRET=""
UPLOAD_DIR="./.uploads"

# Optional, and the only variable here that is. It turns the bulk tab into the
# AI import: Claude groups a drop of photos by what is in them and writes the
# Hebrew name and description for each item. Without it the app boots and the
# shop is untouched — the bulk tab keeps today's uploader, which groups photos
# by capture time and writes no copy. See the README's import section.
ANTHROPIC_API_KEY=""
