generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Item {
  id            String      @id @default(cuid())
  slug          String      @unique // see §7; Hebrew name, hyphenated, + 6-char suffix
  name          String
  description   String
  priceAgorot   Int
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id])
  pickupFrom    DateTime    @db.Date
  pickupTo      DateTime    @db.Date
  status        ItemStatus  @default(DRAFT)
  sortIndex     Int         @default(0)
  importBatchId String? // the drop this item was created from; null for hand-made items
  // When a model last wrote this item's description, or null for one no model
  // has written. Not `updatedAt`, which any edit bumps: this exists so that
  // the shop-wide rewrite can tell what it has already paid for. Without it a
  // seller who presses the button twice buys the same descriptions twice.
  descriptionWrittenAt DateTime?
  // How many times a model has been asked to describe this item and come back
  // with nothing usable. The retry it buys is for a network blip; the CAP it
  // buys is the point — without one, an item the model will never describe
  // stays at the front of the queue, is paid for again on every press, and
  // keeps the screen telling the seller to press again.
  descriptionAttempts   Int      @default(0)
  photos        Photo[]
  orderItems    OrderItem[]
  events        Event[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, sortIndex])
  @@index([categoryId])
  @@index([importBatchId])
}

model Photo {
  id            String    @id @default(cuid())
  itemId        String? // nullable: an imported photo exists before its product does
  item          Item?     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  importBatchId String? // groups one drop; null for photos added the old way
  width         Int
  height        Int
  lqip          String // base64 data URI, ~20 bytes of blur
  position      Int       @default(0)
  takenAt       DateTime? // EXIF DateTimeOriginal, used for bulk grouping

  @@index([itemId, position])
  @@index([importBatchId])
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  items Item[]
}

model Order {
  id            String      @id @default(cuid())
  code          String      @unique // short, human-typeable: "YS-4821"
  token         String      @unique // 22-char url-safe random, used in URLs
  buyerName     String
  buyerPhone    String
  status        OrderStatus @default(PENDING_PAYMENT)
  pickupDate    DateTime    @db.Date
  pickupSlot    PickupSlot
  totalAgorot   Int
  holdExpiresAt DateTime? // null once the buyer declares payment
  claimedAt     DateTime?
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  items         OrderItem[]
  createdAt     DateTime    @default(now())

  @@index([status, createdAt])
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item   @relation(fields: [itemId], references: [id])
  priceAgorot Int // snapshot; editing the item never alters a placed order

  @@unique([orderId, itemId])
  @@index([itemId])
}

model Settings {
  id              Int       @id @default(1) // singleton row, always id = 1
  shopName        String
  tagline         String
  bitPhone        String
  addressLine     String
  city            String
  slotMorning     String // e.g. "09:00–12:00"
  slotAfternoon   String
  slotEvening     String
  // The sale's collection window: the days the seller is home to hand things
  // over, and what every new item's pickup window opens at. Nullable because
  // "not set yet" is a real state — a first-run shop has no dates, and the
  // code falls back to today → today+14 rather than inventing a stored one.
  // Both ends move together: a row never holds one without the other.
  saleFrom        DateTime? @db.Date
  saleTo          DateTime? @db.Date
  holdMinutes     Int       @default(15)
  dismissedMerges String[]  @default([]) // "<idA>:<idB>", ids sorted; see §8
}

/**
 * One thing a visitor did. The whole of this shop's analytics.
 *
 * It lives in the shop's own database rather than in a third-party tracker for
 * three reasons: no buyer's browsing leaves the seller's own server, there is
 * no script to add and no cookie banner to answer for, and item events join
 * straight onto Item — which is what makes "which things are people actually
 * looking at" answerable next to the price and the status.
 *
 * `visitorId` is a random opaque id from a first-party cookie. It is not an
 * IP, not a fingerprint, and not linkable to a person: it says "the same
 * browser came back", which is all a unique-visitor count needs.
 */
model Event {
  id        String    @id @default(cuid())
  visitorId String
  kind      EventKind
  // Null for a shop-wide event. Cascades, so deleting an item takes its
  // history with it rather than leaving rows pointing at nothing — and so
  // that `deleteItem` keeps working without knowing this table exists.
  itemId    String?
  item      Item?     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([itemId, kind])
  @@index([visitorId])
}

enum EventKind {
  VIEW_SHOP // the grid, however it was filtered
  VIEW_ITEM // an item page or its quick-look overlay
  ADD_TO_CART
}

enum ItemStatus {
  DRAFT // never published; the entry form's working row
  AVAILABLE
  RESERVED
  SOLD
  HIDDEN // published once, taken off the shop by the seller; keeps its slug
}

enum OrderStatus {
  PENDING_PAYMENT
  CLAIMED_PAID
  PAID
  EXPIRED
  CANCELLED
}

enum PickupSlot {
  MORNING
  AFTERNOON
  EVENING
}
